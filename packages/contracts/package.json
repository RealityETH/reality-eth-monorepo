{
  "name": "@reality.eth/contracts",
  "version": "3.2.30",
  "description": "Collection of smart contracts for the Realitio fact verification platform",
  "scripts": {
    "generate-chains": "node scripts/generate_chains_json.js",
    "generate-contracts": "node scripts/generate_contract_json.js",
    "generate-tokens": "node scripts/generate_token_json.js",
    "generate": "node scripts/generate_token_json.js && node scripts/generate_chains_json.js && node scripts/generate_contract_json.js && node scripts/generate_factory_json.js && node scripts/generate_website_data.js && node scripts/generate_ponder_config.js && node scripts/generate_indexer_config.js && node scripts/generate_mcp_data.js",
    "generate-ponder-config": "node scripts/generate_ponder_config.js",
    "generate-indexer-config": "node scripts/generate_indexer_config.js",
    "generate-website-data": "node scripts/generate_website_data.js",
    "install-website-data": "node scripts/generate_website_data.js --install",
    "fmt": "prettier 'development/contracts/*.sol' -w",
    "fmt:check": "prettier 'development/contracts/*.sol' -c"
  },
  "main": "index.js",
  "keywords": [
    "Ethereum",
    "Reality.eth",
    "Realitio",
    "Reality Check",
    "Reality Keys",
    "oracle"
  ],
  "author": "Edmund Edgar (https://reality.eth.link)",
  "license": "GPL-3.0",
  "devDependencies": {
    "prettier": "^3.2.4",
    "prettier-plugin-solidity": "^1.3.1",
    "require-glob": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RealityETH/monorepo.git"
  },
  "bugs": {
    "url": "https://github.com/RealityETH/monorepo/issues"
  },
  "homepage": "https://reality.eth.link",
  "gitHead": "57eca8b4b15ca6d22b0d499213b9a2e35fb4ddf8",
  "dependencies": {
    "ethers": "^5.8.0"
  }
}
