# Custom GraphQL server — serves reality.* tables written by sync.js.
# Alternative to packages/ponder/reality-eth-ponder.service (native ponder serve).
# Do NOT run both simultaneously on the same port.
#
# Install:
#   cp reality-eth-serve.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now reality-eth-serve

[Unit]
Description=reality.eth GraphQL API server
After=network.target postgresql.service
Requires=postgresql.service
OnFailure=reality-eth-notify@%n.service

[Service]
Type=simple
User=rcdev
WorkingDirectory=/srv/rcdev/reality-eth-design/packages/indexer
Environment=PATH=/home/rcdev/.nvm/versions/node/v23.11.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PORT=42070
ExecStart=/home/rcdev/.nvm/versions/node/v23.11.0/bin/node serve.js
StandardOutput=append:/srv/rcdev/reality-eth-design/packages/indexer/serve.log
StandardError=append:/srv/rcdev/reality-eth-design/packages/indexer/serve.log
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
