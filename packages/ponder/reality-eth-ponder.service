[Unit]
Description=reality.eth Ponder indexer
After=network.target

[Service]
Type=simple
User=rcdev
WorkingDirectory=/srv/rcdev/reality-eth-design/packages/ponder
Environment=PATH=/home/rcdev/.nvm/versions/node/v23.11.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=node node_modules/.bin/ponder start --log-format json
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
