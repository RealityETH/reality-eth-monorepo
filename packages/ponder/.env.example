# RPC URLs for each chain. Use a provider with archive node access
# (Alchemy, Infura, QuickNode, etc.) — public RPCs may rate-limit during sync.

# Ethereum Mainnet (chain 1)
# Indexes both v3.0 (block 13194676) and v2.0 (block 6531265, ~2019).
# The v2.0 backfill is large — expect several hours on first sync.
PONDER_RPC_URL_1=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Gnosis Chain (chain 100) — Omen prediction markets
PONDER_RPC_URL_100=https://rpc.gnosischain.com

# Polygon (chain 137)
PONDER_RPC_URL_137=https://polygon-rpc.com

# Arbitrum One (chain 42161)
PONDER_RPC_URL_42161=https://arb1.arbitrum.io/rpc

# Optimism (chain 10)
PONDER_RPC_URL_10=https://mainnet.optimism.io

# Base (chain 8453)
PONDER_RPC_URL_8453=https://mainnet.base.org

# Sepolia testnet (chain 11155111)
PONDER_RPC_URL_11155111=https://rpc.sepolia.org

# Required — schema name Ponder uses in its embedded PGlite database (or in Postgres).
# Any name works; the schema is created automatically.
DATABASE_SCHEMA=ponder

# Optional — set to use PostgreSQL instead of the embedded PGlite database.
# DATABASE_URL=postgresql://user:password@localhost:5432/reality_eth
